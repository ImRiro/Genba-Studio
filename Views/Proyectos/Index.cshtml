@model GenbaStudio.Models.Common.PagedResult<GenbaStudio.Models.Entities.Proyecto>
@using GenbaStudio.Models.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Mis proyectos";
    var estadoActual = ViewData["estado"] as EstadoProyecto?;
}

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mis proyectos</h1>
    <a asp-action="Nuevo" class="btn btn-primary">Nuevo proyecto</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="q" value="@ViewData["q"]" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-md-3">
        <select name="estado" class="form-select">
            <option value="">Todos los estados</option>
            @foreach (var e in Enum.GetValues<EstadoProyecto>())
            {
                <option value="@e" selected="@(e == estadoActual)">@Textos.De(e)</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Inicio</th>
                <th>Entrega</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@p.FechaEntrega.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge text-bg-secondary">@Textos.De(p.Estado)</span></td>
                    <td class="text-end">
                        <a asp-controller="Escenas" asp-action="Index" asp-route-proyectoId="@p.Id" class="btn btn-sm btn-outline-secondary">Escenas</a>
                        <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar el proyecto @p.Nombre?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No hay proyectos para mostrar.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center">
    <small class="text-muted">Página @Model.Page de @Math.Max(Model.TotalPages, 1) (@Model.TotalCount en total)</small>
    <div class="btn-group">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-page="@(Model.Page - 1)"
               asp-route-q="@ViewData["q"]" asp-route-estado="@ViewData["estado"]"
               class="btn btn-sm btn-outline-secondary">Anterior</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-page="@(Model.Page + 1)"
               asp-route-q="@ViewData["q"]" asp-route-estado="@ViewData["estado"]"
               class="btn btn-sm btn-outline-secondary">Siguiente</a>
        }
    </div>
</div>