@model GenbaStudio.Models.ViewModels.UsuarioFormViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var esNuevo = Model.Id == 0;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<input asp-for="Id" type="hidden" />

<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" autocomplete="off" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" id="Rol" class="form-select"
                asp-items="@(new SelectList(GenbaStudio.Models.Enums.Roles.Todos, Model.Rol))"></select>
        <span asp-validation-for="Rol" class="text-danger"></span>
    </div>
    <div class="col-sm-6 mb-3" id="grupo-especialidad">
        <label asp-for="Especialidad" class="form-label"></label>
        <input asp-for="Especialidad" class="form-control" placeholder="Ej: Cleanup, Color, Key animation" />
        <span asp-validation-for="Especialidad" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        @if (!esNuevo)
        {
            <div class="form-text">Dejala vacía para no cambiarla.</div>
        }
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="ConfirmarPassword" class="form-label"></label>
        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
    </div>
</div>

<script>
    // La especialidad solo aplica a los animadores.
    (function () {
        var rol = document.getElementById('Rol');
        var grupo = document.getElementById('grupo-especialidad');
        function actualizar() { grupo.style.display = rol.value === 'Animador' ? '' : 'none'; }
        rol.addEventListener('change', actualizar);
        actualizar();
    })();
</script>
