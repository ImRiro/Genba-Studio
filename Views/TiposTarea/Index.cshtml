@model IEnumerable<GenbaStudio.Models.Entities.TipoTarea>
@{
    ViewData["Title"] = "Tipos de tarea";
}

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tipos de tarea</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo tipo</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Nombre</td>
                    <td>@(t.Descripcion ?? "—")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="3" class="text-center text-muted py-4">Todavía no hay tipos de tarea.</td></tr>
            }
        </tbody>
    </table>
</div>
