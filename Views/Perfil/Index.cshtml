@model GenbaStudio.Models.ViewModels.PerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
    var avatar = string.IsNullOrEmpty(Model.Avatar) ? "/img/avatar-default.svg" : Model.Avatar;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Mi perfil</h1>

        @if (TempData["Ok"] is string ok)
        {
            <div class="alert alert-success py-2">@ok</div>
        }

        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="d-flex align-items-center gap-3 mb-4">
                <img src="@avatar" alt="Avatar" class="rounded-circle border"
                     style="width:96px;height:96px;object-fit:cover" />
                <div>
                    <div class="fw-semibold">@Model.Email</div>
                    <span class="badge text-bg-secondary">@Model.Rol</span>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
            </div>

            @if (Model.EsAnimador)
            {
                <div class="mb-3">
                    <label asp-for="Especialidad" class="form-label"></label>
                    <input asp-for="Especialidad" class="form-control" placeholder="Ej: Cleanup, Color, Key animation" />
                    <span asp-validation-for="Especialidad" class="text-danger"></span>
                </div>
            }

            <div class="mb-2">
                <label asp-for="AvatarFile" class="form-label"></label>
                <input asp-for="AvatarFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <div class="form-text">JPG, PNG o WEBP, hasta 2 MB.</div>
                <span asp-validation-for="AvatarFile" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Avatar))
            {
                <div class="form-check mb-3">
                    <input asp-for="QuitarAvatar" class="form-check-input" />
                    <label asp-for="QuitarAvatar" class="form-check-label"></label>
                </div>
            }

            <button type="submit" class="btn btn-primary mt-2">Guardar cambios</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
