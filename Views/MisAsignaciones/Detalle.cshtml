@using GenbaStudio.Models.Enums
@model GenbaStudio.Models.ViewModels.DetalleAnimadorViewModel
@{
    ViewData["Title"] = "Asignación";
    var a = Model.Asignacion;
}

<h1 class="h3 mb-3">@a.TipoTarea — @a.Proyecto, escena @a.EscenaNumero</h1>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><span class="badge @Textos.Clase(a.Estado)">@Textos.De(a.Estado)</span></dd>

            <dt class="col-sm-3">Fecha límite</dt>
            <dd class="col-sm-9">
                @a.FechaLimite.ToString("dd/MM/yyyy")
                @if (a.Vencida)
                {
                    <span class="badge bg-danger">Vencida</span>
                }
            </dd>

            <dt class="col-sm-3">Prioridad</dt>
            <dd class="col-sm-9">@Textos.De(a.Prioridad)</dd>

            <dt class="col-sm-3">Observaciones</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(a.Observaciones) ? "—" : a.Observaciones)</dd>

            <dt class="col-sm-3">Storyboard</dt>
            <dd class="col-sm-9">
                @if (Model.TieneStoryboard)
                {
                    <a asp-controller="Archivos" asp-action="Storyboard" asp-route-id="@a.EscenaId" target="_blank">Ver storyboard de la escena</a>
                }
                else
                {
                    <span class="text-muted">La escena no tiene storyboard.</span>
                }
            </dd>
        </dl>
    </div>
</div>

@if (Model.PuedeIniciar)
{
    <form asp-action="Iniciar" asp-route-id="@a.Id" method="post" class="mb-4">
        <button type="submit" class="btn btn-primary">
            @(a.Estado == EstadoAsignacion.Pendiente ? "Comenzar a trabajar" : "Retomar el trabajo (correcciones)")
        </button>
    </form>
}

@if (Model.PuedeSubir)
{
    <div class="card mb-4">
        <div class="card-header">Subir entrega</div>
        <div class="card-body">
            <form asp-action="SubirEntrega" asp-route-id="@a.Id" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Archivo (PSD, ZIP, MP4 o imagen — máx. 100 MB)</label>
                    <input type="file" name="archivo" class="form-control" accept=".psd,.zip,.mp4,.jpg,.jpeg,.png,.webp" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Comentario (opcional)</label>
                    <textarea name="comentario" class="form-control" rows="2" maxlength="1000"></textarea>
                </div>
                <button type="submit" class="btn btn-success">Subir entrega</button>
            </form>
        </div>
    </div>
}
else if (a.Estado == EstadoAsignacion.EnRevision)
{
    <div class="alert alert-info">Tu última entrega está en revisión del director.</div>
}
else if (a.Estado == EstadoAsignacion.Aprobada)
{
    <div class="alert alert-success">Esta asignación fue aprobada.</div>
}

<h2 class="h5">Historial de entregas</h2>
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Versión</th>
                <th>Archivo</th>
                <th>Subida</th>
                <th>Revisión</th>
                <th>Mi comentario</th>
                <th>Feedback del director</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Historial.Any())
            {
                <tr><td colspan="6" class="text-center text-muted">Todavía no subiste entregas.</td></tr>
            }
            @foreach (var h in Model.Historial)
            {
                <tr>
                    <td>v@h.Version</td>
                    <td><a asp-controller="Archivos" asp-action="Entrega" asp-route-id="@h.Id">@h.NombreOriginal</a></td>
                    <td>@h.FechaSubida.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge @Textos.Clase(h.EstadoRevision)">@Textos.De(h.EstadoRevision)</span></td>
                    <td>@h.ComentarioAnimador</td>
                    <td>@h.FeedbackDirector</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-link">Volver a mis asignaciones</a>
