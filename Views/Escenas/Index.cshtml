@model GenbaStudio.Models.Common.PagedResult<GenbaStudio.Models.Entities.Escena>
@using GenbaStudio.Models.Enums
@{
    var proyecto = (GenbaStudio.Models.Entities.Proyecto)ViewData["Proyecto"]!;
    ViewData["Title"] = "Escenas de " + proyecto.Nombre;
}

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Escenas</h1>
        <div class="text-muted">Proyecto: @proyecto.Nombre</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Proyectos" asp-action="Index" class="btn btn-outline-secondary">Volver a proyectos</a>
        <a asp-action="Nueva" asp-route-proyectoId="@proyecto.Id" class="btn btn-primary">Nueva escena</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="proyectoId" value="@proyecto.Id" />
    <div class="col-md-9">
        <input name="q" value="@ViewData["q"]" class="form-control" placeholder="Buscar en la descripción" />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" asp-route-proyectoId="@proyecto.Id" class="btn btn-link">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>N°</th>
                <th>Descripción</th>
                <th>Duración</th>
                <th>Estado</th>
                <th>Storyboard</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Items)
            {
                <tr>
                    <td>@e.Numero</td>
                    <td>@(e.Descripcion ?? "—")</td>
                    <td>@e.DuracionSegundos s</td>
                    <td><span class="badge text-bg-secondary">@Textos.De(e.Estado)</span></td>
                    <td>
                        @if (e.RutaStoryboard != null)
                        {
                            <a asp-action="Storyboard" asp-route-id="@e.Id" target="_blank">Ver</a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form asp-action="Eliminar" asp-route-id="@e.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar la escena @e.Numero?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Este proyecto todavía no tiene escenas.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-between align-items-center">
    <small class="text-muted">Página @Model.Page de @Math.Max(Model.TotalPages, 1) (@Model.TotalCount en total)</small>
    <div class="btn-group">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-page="@(Model.Page - 1)"
               asp-route-q="@ViewData["q"]" asp-route-proyectoId="@ViewData["proyectoId"]"
               class="btn btn-sm btn-outline-secondary">Anterior</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-page="@(Model.Page + 1)"
               asp-route-q="@ViewData["q"]" asp-route-proyectoId="@ViewData["proyectoId"]"
               class="btn btn-sm btn-outline-secondary">Siguiente</a>
        }
    </div>
</div>